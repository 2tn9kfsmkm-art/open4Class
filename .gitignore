*.pyc
__pycache__/

# 本地环境（每台机器自己生成，不入库）
.venv/
.tmp/
.tmp*/
.tmpappdata/
backups/

# 测试产物
.pytest_cache/
.pytest-appdata/
.pytest-tmp/
.test-tmp/
pytest-cache-files-*/
.coverage
.coverage.*
htmlcov/

# 数据：含真实学生姓名，不入库；改动前请先跑一次备份（见 backups/）
*.csv

# 分享用的 git bundle 与打包产物，不入库
*.bundle
dist/
build/

# 消息页里的班级照片，同样不入库
messages/images/

# 图片：只放行程序图标与 logo，其余（消息图片）一律忽略
*.png
!resources/*.png

# 冒烟脚本输出
.run-*.txt

# macOS 资源文件
._*
