#applink_tv {
    border: none; /* 类似于文本框的浅灰色边框 */
    background-color: transparent; /* 白色背景 */
    gridline-color: transparent; /* 隐藏网格线 */
    selection-background-color: #790910; /* 选中项的背景色 */
    font-size: 20pt;
    color: white;
    margin-right:0em;
    margin-top: 6px;
    /* 可选：设置字体，与你的应用其他部分一致 */
    /* font-family: "Segoe UI"; */
}
#applink_tv::item {
    background-color: #9b0d14;
    border-radius: 6px;
    padding:5px;
    margin: 6px;
    border:1px solid transparent;
    outline: 0px;
    font-weight: bold;
}

#applink_tv::item:hover {
    background-color: #9b0d14;
}