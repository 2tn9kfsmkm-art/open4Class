QTableView {
    border: 0px; /* 类似于文本框的浅灰色边框 */
    background-color: transparent;
    gridline-color: transparent; /* 隐藏网格线 */
    selection-background-color: @primary-muted; /* 选中项的背景色 */
    selection-color: black; /* 选中项的文本颜色 */
    font-size: @font-table;
    /* 可选：设置字体，与你的应用其他部分一致 */
    /* font-family: "Segoe UI"; */
}

/* 设置每个单元格（Item）的样式 */
QTableView::item {
    padding: 10px 5px; /* 单元格内边距，类似文本框文本的间距 */
    border: none; /* 去除单元格的边框 */
}

QHeaderView::section {
    border:0px;
    background-color:transparent
}

/* 隐藏QTableView的角按钮（左上角那个） */
QTableCornerButton::section {
    border: 0px;
    background-color: transparent;
}
